generator client {
  provider      = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
  AGENT
}
enum VendorStatus {
  APPLIED
  KYC_SUBMITTED
  APPROVED
  REJECTED
  SUSPENDED
}
enum ProductStatus {
  DRAFT
  REVIEW
  ACTIVE
  ARCHIVED
}
enum SubOrderStatus {
  PENDING_PAYMENT
  PAID
  AWAITING_COLLECTION
  PACKED
  SHIPPED
  DELIVERED
  RETURN_REQUESTED
  REFUNDED
  SETTLED
  EXPIRED
  CANCELLED
}
enum ReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}
enum PaymentMethod {
  CARD
  COD
}
enum PaymentStatus {
  INITIALIZED
  PAID
  FAILED
}
enum Direction {
  DEBIT
  CREDIT
}
enum ReturnStatus {
  REQUESTED
  ACCEPTED
  DISPUTED
  REFUNDED
  REJECTED
}
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String @map("password_hash")
  name         String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at")
  vendor       VendorProfile?
  addresses    Address[]
  cart         Cart?
  orders       Order[]
  refreshTokens RefreshToken[]
  reviews      Review[]
  notifications Notification[]
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @db.Uuid @map("user_id")
  familyId   String    @db.Uuid @map("family_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id])
  @@index([familyId])
  @@map("refresh_tokens")
}

model VendorProfile {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String       @unique @db.Uuid @map("user_id")
  storeName  String @map("store_name")
  slug       String       @unique
  status     VendorStatus @default(APPLIED)
  kycKey     String? @map("kyc_key")
  kycNote    String? @map("kyc_note")
  flagged    Boolean      @default(false)
  score      Int          @default(100)
  approvedAt DateTime? @map("approved_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  user       User         @relation(fields: [userId], references: [id])
  products   Product[]
  subOrders  SubOrder[]
  payouts    Payout[]
  @@map("vendor_profiles")
}

model Address {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid @map("user_id")
  line1  String
  city   String
  state  String
  phone  String
  user   User   @relation(fields: [userId], references: [id])
  @@map("addresses")
}

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  products  Product[]
  rule      CommissionRule?
  @@map("categories")
}

/// categoryId NULL = platform default rule. Changes affect only new orders (snapshot on sub_orders).
model CommissionRule {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId String?   @unique @db.Uuid @map("category_id")
  bps        Int
  updatedAt  DateTime  @default(now()) @map("updated_at")
  category   Category? @relation(fields: [categoryId], references: [id])
  @@map("commission_rules")
}

model Product {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId    String        @db.Uuid @map("vendor_id")
  categoryId  String        @db.Uuid @map("category_id")
  slug        String        @unique
  title       String
  description String        @default("")
  status      ProductStatus @default(DRAFT)
  ratingAvg   Float         @default(0) @map("rating_avg")
  ratingCount Int           @default(0) @map("rating_count")
  createdAt   DateTime      @default(now()) @map("created_at")
  vendor      VendorProfile @relation(fields: [vendorId], references: [id])
  category    Category      @relation(fields: [categoryId], references: [id])
  variants    Variant[]
  images      ProductImage[]
  reviews     Review[]
  @@index([vendorId])
  @@index([categoryId, status])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @db.Uuid @map("product_id")
  key       String  @unique
  status    String  @default("PENDING")
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id])
  @@map("product_images")
}

model Variant {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String    @db.Uuid @map("product_id")
  sku        String    @unique
  name       String    @default("Default")
  priceKobo  BigInt @map("price_kobo")
  product    Product   @relation(fields: [productId], references: [id])
  inventory  Inventory?
  flashSales FlashSale[]
  @@index([productId])
  @@map("variants")
}

model FlashSale {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId String   @db.Uuid @map("variant_id")
  priceKobo BigInt @map("price_kobo")
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  variant   Variant  @relation(fields: [variantId], references: [id])
  @@index([startsAt, endsAt])
  @@map("flash_sales")
}

model Inventory {
  variantId String  @id @db.Uuid @map("variant_id")
  onHand    Int @map("on_hand")
  reserved  Int     @default(0)
  variant   Variant @relation(fields: [variantId], references: [id])
  @@map("inventory")
}

model Reservation {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String            @db.Uuid @map("order_id")
  variantId String            @db.Uuid @map("variant_id")
  qty       Int
  expiresAt DateTime @map("expires_at")
  status    ReservationStatus @default(ACTIVE)
  @@index([orderId])
  @@index([status, expiresAt])
  @@map("reservations")
}

model Cart {
  id     String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String     @unique @db.Uuid @map("user_id")
  user   User       @relation(fields: [userId], references: [id])
  items  CartItem[]
  @@map("carts")
}

model CartItem {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId         String  @db.Uuid @map("cart_id")
  variantId      String  @db.Uuid @map("variant_id")
  qty            Int
  unitPriceKobo  BigInt @map("unit_price_kobo")
  cart           Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  @@unique([cartId, variantId])
  @@map("cart_items")
}

model CheckoutRequest {
  idempotencyKey String   @id @map("idempotency_key")
  userId         String   @db.Uuid @map("user_id")
  orderId        String?  @db.Uuid @map("order_id")
  response       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  @@map("checkout_requests")
}

model Order {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String        @db.Uuid @map("user_id")
  totalKobo     BigInt @map("total_kobo")
  paymentMethod PaymentMethod @default(CARD) @map("payment_method")
  address       Json?
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  user          User          @relation(fields: [userId], references: [id])
  subOrders     SubOrder[]
  payments      Payment[]
  @@index([userId])
  @@map("orders")
}

model SubOrder {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String         @db.Uuid @map("order_id")
  vendorId      String         @db.Uuid @map("vendor_id")
  status        SubOrderStatus @default(PENDING_PAYMENT)
  subtotalKobo  BigInt @map("subtotal_kobo")
  commissionBps Int @map("commission_bps")
  commissionKobo BigInt @map("commission_kobo")
  feeKobo       BigInt         @default(0) @map("fee_kobo")
  courier       String?
  trackingNo    String? @map("tracking_no")
  paidAt        DateTime? @map("paid_at")
  shippedAt     DateTime? @map("shipped_at")
  deliveredAt   DateTime? @map("delivered_at")
  settledAt     DateTime? @map("settled_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  order         Order          @relation(fields: [orderId], references: [id])
  vendor        VendorProfile  @relation(fields: [vendorId], references: [id])
  items         OrderItem[]
  returns       ReturnRequest[]
  @@index([orderId])
  @@index([vendorId, status])
  @@map("sub_orders")
}

model OrderItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subOrderId    String   @db.Uuid @map("sub_order_id")
  variantId     String   @db.Uuid @map("variant_id")
  productId     String   @db.Uuid @map("product_id")
  title         String
  qty           Int
  unitPriceKobo BigInt @map("unit_price_kobo")
  subOrder      SubOrder @relation(fields: [subOrderId], references: [id])
  @@map("order_items")
}

model Payment {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String        @db.Uuid @map("order_id")
  provider    String
  reference   String        @unique
  amountKobo  BigInt @map("amount_kobo")
  feeKobo     BigInt        @default(0) @map("fee_kobo")
  status      PaymentStatus @default(INITIALIZED)
  createdAt   DateTime      @default(now()) @map("created_at")
  order       Order         @relation(fields: [orderId], references: [id])
  @@map("payments")
}

model PaymentEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId    String   @unique @map("event_id")
  type       String
  reference  String
  payload    Json
  receivedAt DateTime @default(now()) @map("received_at")
  @@map("payment_events")
}

/// Append-only. DB trigger rejects UPDATE/DELETE; app role has no such grants.
model LedgerEntry {
  id         BigInt    @id @default(autoincrement())
  groupId    String    @db.Uuid @map("group_id")
  subOrderId String?   @db.Uuid @map("sub_order_id")
  vendorId   String?   @db.Uuid @map("vendor_id")
  account    String
  direction  Direction
  amountKobo BigInt @map("amount_kobo")
  ref        String
  createdAt  DateTime  @default(now()) @map("created_at")
  @@index([subOrderId])
  @@index([vendorId, account])
  @@index([groupId])
  @@map("ledger_entries")
}

model Payout {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId   String   @db.Uuid @map("vendor_id")
  runKey     String @map("run_key")
  amountKobo BigInt @map("amount_kobo")
  createdAt  DateTime @default(now()) @map("created_at")
  vendor     VendorProfile @relation(fields: [vendorId], references: [id])
  @@unique([vendorId, runKey])
  @@map("payouts")
}

model ReturnRequest {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subOrderId     String       @db.Uuid @map("sub_order_id")
  userId         String       @db.Uuid @map("user_id")
  reason         String
  status         ReturnStatus @default(REQUESTED)
  vendorDeadline DateTime @map("vendor_deadline")
  vendorResponse String? @map("vendor_response")
  decidedBy      String?      @db.Uuid @map("decided_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  subOrder       SubOrder     @relation(fields: [subOrderId], references: [id])
  @@index([status, vendorDeadline])
  @@map("return_requests")
}

model Review {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @db.Uuid @map("product_id")
  userId    String   @db.Uuid @map("user_id")
  rating    Int
  body      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  @@unique([productId, userId])
  @@map("reviews")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid @map("user_id")
  type      String
  payload   Json
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id])
  @@index([userId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?  @db.Uuid @map("actor_id")
  action    String
  entity    String
  entityId  String @map("entity_id")
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")
  @@map("audit_log")
}
