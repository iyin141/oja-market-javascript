# Copy to .env. One file for compose + local dev.
# --- PostgreSQL ---
# Local dev: the compose postgres below. Neon: paste the connection strings from the Neon dashboard (Connect), keep ?sslmode=require.
#   DATABASE_URL          runtime, POOLED host (contains -pooler), connects as the restricted app role oja_app
#   MIGRATE_DATABASE_URL  migrations/seed, DIRECT host, connects as the project owner (it creates the oja_app role and ledger triggers)
# On Neon set the oja_app password after the first migrate:  ALTER ROLE oja_app PASSWORD '<new>';  and use it in DATABASE_URL.
DATABASE_URL=postgresql://oja_app:oja_app@localhost:5433/oja
MIGRATE_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/oja
# Used only by `docker compose` (the api/worker containers); leave unset to use the compose postgres service
DOCKER_DATABASE_URL=
DOCKER_MIGRATE_DATABASE_URL=
REDIS_URL=redis://localhost:6380
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=ojaaccess
S3_SECRET_KEY=ojasecret
S3_BUCKET_PUBLIC=oja-public
S3_BUCKET_PRIVATE=oja-private
S3_FORCE_PATH_STYLE=true
PAYMENT_PROVIDER=fake
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_WEBHOOK_SECRET=sk_test_replace_me
FAKE_PROVIDER_SECRET=fake-secret
SMTP_URL=smtp://localhost:1125
WEB_ORIGIN=http://localhost:3100
PORT=4100
COD_LIMIT_KOBO=15000000
RESERVATION_TTL_MIN=15
SETTLEMENT_HOLD_DAYS=7

# --- Stripe (test mode) with Connect: set PAYMENT_PROVIDER=stripe. Keys must be sk_test_...
STRIPE_SECRET_KEY=            # sk_test_...
STRIPE_WEBHOOK_SECRET=        # whsec_... (webhook endpoint: POST /payments/webhook)
STRIPE_CURRENCY=usd
# --- Elasticsearch (blank = Postgres full-text search). Local compose: http://localhost:9200. Elastic Cloud: https://<id>.es.<region>.elastic-cloud.com
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=        # Elastic Cloud API key (sent as "Authorization: ApiKey ..."); blank for local
ES_REINDEX_SEC=60
