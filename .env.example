# Copy to .env. One file for compose + local dev.
DATABASE_URL=postgresql://oja_app:oja_app@localhost:5433/oja
MIGRATE_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/oja
REDIS_URL=redis://localhost:6380
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=ojaaccess
S3_SECRET_KEY=ojasecret
S3_BUCKET_PUBLIC=oja-public
S3_BUCKET_PRIVATE=oja-private
S3_FORCE_PATH_STYLE=true
PAYMENT_PROVIDER=fake
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_WEBHOOK_SECRET=sk_test_replace_me
FAKE_PROVIDER_SECRET=fake-secret
SMTP_URL=smtp://localhost:1125
WEB_ORIGIN=http://localhost:3100
PORT=4100
COD_LIMIT_KOBO=15000000
RESERVATION_TTL_MIN=15
SETTLEMENT_HOLD_DAYS=7
